{
  "name": "ranymizer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174 --strictPort",
    "dev:local": "VITE_ENGINE=local vite dev --port 5174 --strictPort",
    "dev:mock": "VITE_ENGINE=mock vite dev --port 5174 --strictPort",
    "build": "vite build",
    "build:local": "VITE_ENGINE=local vite build",
    "build:mock": "VITE_ENGINE=mock vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "format:check": "biome check ./src",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "svelte": "^5.55.8",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@gradio/client": "^2.2.0",
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2.11.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "pdfjs-dist": "^5.7.284",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  }
}
